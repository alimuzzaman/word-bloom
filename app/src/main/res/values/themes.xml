<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base theme. Compose owns all in-app styling; this exists so the window has
      sane colours before the first frame composes.
    -->
    <style name="Theme.WordPuzzle" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_deep</item>
        <item name="android:navigationBarColor">@color/brand_deep</item>
        <item name="android:windowBackground">@color/brand_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!--
      Launch theme applied to MainActivity. Painting the brand background in the
      window itself removes the white flash between process start and first frame,
      so the Compose splash appears to fade in from the same colour.
    -->
    <style name="Theme.WordPuzzle.Splash" parent="Theme.WordPuzzle">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
